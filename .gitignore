# ============================================================
# 本项目 .gitignore 约定
# 分类原则：只忽略「本地生成 / 下载候选 / 运行产物」；
# game/assets/** 下的正式入库资产一律不在此列。
# ============================================================

# ----- 第三方原始素材包（来源 URL 与校验值见 docs/source-manifest.json）-----
docs/01-参考资料包/
assets/third_party/hardvacuum/

# ----- 开源参考实现与本地 TTS 运行时（仅本地研究，不进入成品）-----
third_party/reference-games/
third_party/moss-tts-nano/

# ----- 验收截图 / 调试日志（本地临时产物，不入库、不写入文档）-----
# gda / Xvfb / 压力测试产生的截图与日志统一放这里，需要时现场生成。
docs/screenshots/

# ----- Godot 引擎缓存、工具 harness 与导出产物 -----
game/.godot/
game/addons/gda_harness/
game/export/
game/build/
game/android/build/
game/ios/build/

# ----- 索引数据库（本地生成）-----
.codegraph/

# ----- Python / Pillow 运行缓存 -----
__pycache__/
*.pyc
.venv/

# ----- 像素素材临时研究输出（正式导出走 game/assets/）-----
pixel-art/**/*_study/

# ----- 生成候选包（筛选后的正式文件才复制到 game/assets/）-----
generated/game_icons/
generated/tileset_candidates/
generated/character_candidates/

# ----- CI 工具、构建产物与日志 -----
.tools/
artifacts/
*.log

# ----- 本地密钥与环境变量 -----
.env
.env.*

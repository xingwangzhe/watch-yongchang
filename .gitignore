# 第三方原始素材包（约 1.2GB，来源 URL 与校验值见 docs/source-manifest.json）
docs/01-参考资料包/

# 编辑器与系统临时文件
.DS_Store
Thumbs.db
*.swp
*~

# Godot 引擎缓存
game/.godot/
game/addons/gda_harness/
game/export/
game/build/
game/android/build/
game/ios/build/

# CodeGraph 索引库（本地生成，不入库）
.codegraph/

# 第三方原始素材包（不入库）
assets/third_party/hardvacuum/

# Python / Pillow 运行缓存
__pycache__/
*.pyc
.venv/

# 像素素材临时输出
pixel-art/**/*_study/

# game-icons.net 下载缓存（筛选后再复制到 game/assets，未采用的文件不入库）
generated/game_icons/

# 地图瓦片候选包（仅下载审视，未采用的包与文件不入库）
generated/tileset_candidates/

# CI 工具与构建产物
.tools/
artifacts/
*.log

# 本地密钥与环境变量
.env
.env.*
